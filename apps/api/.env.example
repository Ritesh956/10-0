DATABASE_URL="postgresql://futbol:futbol@localhost:5432/futbol?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
PORT=4000

# Passwordless sign-in (all optional in dev).
# Where sign-in links point (the web app's origin).
WEB_URL=http://localhost:5173
# Google Identity Services OAuth client id (Web application type; add your origins as authorized
# JavaScript origins). Unset = the Google button is hidden.
GOOGLE_CLIENT_ID=
# Resend (https://resend.com) for sign-in emails. Unset = the link is printed to the API log instead.
RESEND_API_KEY=
MAIL_FROM="Futbol <signin@your-domain.example>"
