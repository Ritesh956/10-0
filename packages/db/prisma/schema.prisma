// Futbol database schema — see the architecture doc for rationale.
//
// Two logical halves, per the "reference catalog vs world state" decision:
//   1. Reference catalog (Ref* models): read-mostly, versioned, swappable.
//      This is where "real data" lives; nothing downstream hardcodes it.
//   2. World/save state (World*, Season, Fixture, Match*, ...): read-write,
//      copy-on-write per save, scoped by worldId. A world is one single-player
//      save or one multiplayer league.
//
// Phase 1 (MVP) exercises Era/RefLeague/RefClub/RefClubSeason/RefPlayer/
// RefPlayerSeason plus World/WorldClub/WorldPlayer/Season/Competition/
// Fixture/Match/MatchEvent/PlayerMatchStat end-to-end. The remaining models
// (contracts, staff, youth, finances, transfers, awards, records,
// achievements, multiplayer chat/presence) are schema-complete per the
// architecture but are filled in as their phases (2-6) land.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Guests (isGuest: true) have no email/passwordHash — just a display name, so
/// play requires no signup. "Upgrading" a guest sets email/passwordHash on the
/// same row (same id) so their worlds/history carry over.
model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  passwordHash String?
  displayName  String
  isGuest      Boolean  @default(false)
  createdAt    DateTime @default(now())

  worlds World[]

  @@map("users")
}

// ============================================================================
// Reference catalog
// ============================================================================

model Era {
  id        String   @id @default(cuid())
  name      String
  startYear Int
  endYear   Int
  createdAt DateTime @default(now())

  leagues RefLeague[]
  worlds  World[]

  @@map("eras")
}

model RefLeague {
  id      String @id @default(cuid())
  eraId   String
  name    String
  country String
  tier    Int    @default(1)

  era          Era              @relation(fields: [eraId], references: [id])
  clubSeasons  RefClubSeason[]
  competitions RefCompetition[]

  @@index([eraId])
  @@map("ref_leagues")
}

model RefClub {
  id       String  @id @default(cuid())
  name     String
  country  String
  badgeRef String?

  clubSeasons RefClubSeason[]

  @@map("ref_clubs")
}

/// One club's instance in one season — e.g. "Barcelona 2009". The draftable club unit.
model RefClubSeason {
  id         String @id @default(cuid())
  clubId     String
  seasonYear Int
  leagueId   String
  reputation Int

  club          RefClub           @relation(fields: [clubId], references: [id])
  league        RefLeague         @relation(fields: [leagueId], references: [id])
  playerSeasons RefPlayerSeason[]
  worldClubs    WorldClub[]

  @@unique([clubId, seasonYear])
  @@index([leagueId])
  @@map("ref_club_seasons")
}

model RefPlayer {
  id          String   @id @default(cuid())
  name        String
  nationality String
  dateOfBirth DateTime
  photoUrl    String?

  playerSeasons RefPlayerSeason[]

  @@map("ref_players")
}

/// A player's attributes as they were in one specific season — e.g. "Henry 2004". The draftable player unit.
model RefPlayerSeason {
  id            String   @id @default(cuid())
  playerId      String
  clubSeasonId  String
  seasonYear    Int
  positions     String[]
  preferredFoot String
  weakFoot      Int
  /// PlayerAttributes shape from @futbol/domain, stored as JSONB.
  attributes    Json
  overall       Int
  potential     Int
  traits        String[]

  player       RefPlayer     @relation(fields: [playerId], references: [id])
  clubSeason   RefClubSeason @relation(fields: [clubSeasonId], references: [id])
  worldPlayers WorldPlayer[]

  @@index([clubSeasonId])
  @@index([playerId])
  @@map("ref_player_seasons")
}

/// Tactical identity is our own classification of well-documented real playstyles (see
/// packages/db/prisma/seed-managers.ts) — not copied from any proprietary rating system.
model RefManager {
  id                String  @id @default(cuid())
  name              String
  nationality       String
  /// Short human-readable blurb for UI display, e.g. "Fluid possession, intense counter-press".
  philosophy        String?
  mentality         String
  tempo             String
  width             String
  pressing          String
  passingStyle      String
  /// One of the domain Tactics.managerPhilosophy enum values; display-only, no separate engine modifier.
  managerPhilosophy String?

  worldClubs WorldClub[]

  @@map("ref_managers")
}

model RefCompetition {
  id       String  @id @default(cuid())
  leagueId String?
  name     String
  type     String // "league" | "domestic-cup" | "continental" | "international"

  league RefLeague? @relation(fields: [leagueId], references: [id])

  @@map("ref_competitions")
}

model RefKit {
  id       String @id @default(cuid())
  clubId   String
  season   Int
  kind     String // "home" | "away" | "third"
  assetRef String

  @@index([clubId])
  @@map("ref_kits")
}

model RefBadge {
  id       String @id @default(cuid())
  clubId   String
  assetRef String

  @@index([clubId])
  @@map("ref_badges")
}

// ============================================================================
// World / save state — everything below is scoped by worldId
// ============================================================================

enum WorldType {
  SINGLE
  LEAGUE
}

enum WorldStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model World {
  id        String      @id @default(cuid())
  ownerId   String
  type      WorldType
  eraId     String
  status    WorldStatus @default(ACTIVE)
  /// { europeanNights: boolean, januaryWindow: boolean } — the Setup "Advanced" toggles, previously
  /// decided client-side (DraftContext) but never sent to the backend. A single Json blob rather than
  /// two columns so future Setup toggles don't each need their own migration.
  settings  Json?
  createdAt DateTime    @default(now())

  owner         User           @relation(fields: [ownerId], references: [id])
  era           Era            @relation(fields: [eraId], references: [id])
  clubs         WorldClub[]
  players       WorldPlayer[]
  seasons       Season[]
  competitions  Competition[]
  fixtures      Fixture[]
  matches       Match[]
  knockoutTies  KnockoutTie[]
  transfers     Transfer[]
  januaryEvents JanuaryEvent[]
  chatMessages  ChatMessage[]

  @@index([ownerId])
  @@map("worlds")
}

/// A club instantiated inside a world/save; copy-on-write from a RefClubSeason so the world evolves independently.
model WorldClub {
  id              String  @id @default(cuid())
  worldId         String
  refClubSeasonId String?
  name            String
  managedByUserId String? // null = AI-controlled
  formation       String?
  /// Live reference to the reference catalog (not copied — a manager's tactics don't evolve during a world's life).
  refManagerId    String?
  /// Array of {position, playerId} — exactly 11 once drafted. Domain Squad.startingXI shape.
  lineup          Json?
  /// Array of {position, playerId}, up to 12. Domain Squad.substitutes shape.
  bench           Json?

  world         World          @relation(fields: [worldId], references: [id])
  refClubSeason RefClubSeason? @relation(fields: [refClubSeasonId], references: [id])
  refManager    RefManager?    @relation(fields: [refManagerId], references: [id])
  players       WorldPlayer[]
  contracts     Contract[]
  staff         Staff[]
  youthPlayers  YouthPlayer[]
  finances      Finance[]

  @@index([worldId])
  @@map("world_clubs")
}

/// A player instantiated inside a world/save; snapshot of a RefPlayerSeason's attributes that then diverges over time.
model WorldPlayer {
  id                String   @id @default(cuid())
  worldId           String
  clubId            String
  refPlayerSeasonId String
  name              String
  photoUrl          String?
  age               Int
  positions         String[]
  preferredFoot     String
  weakFoot          Int
  attributes        Json
  overall           Int
  potential         Int
  traits            String[]
  fitness           Float    @default(1)
  morale            Float    @default(0.5)
  form              Float    @default(0.5)
  sharpness         Float    @default(1)

  world           World           @relation(fields: [worldId], references: [id])
  club            WorldClub       @relation(fields: [clubId], references: [id])
  refPlayerSeason RefPlayerSeason @relation(fields: [refPlayerSeasonId], references: [id])
  contracts       Contract[]

  @@index([worldId, clubId])
  @@map("world_players")
}

enum CompetitionType {
  LEAGUE
  DOMESTIC_CUP
  CONTINENTAL
  INTERNATIONAL
  CUSTOM
}

model Competition {
  id      String          @id @default(cuid())
  worldId String
  name    String
  type    CompetitionType

  world   World    @relation(fields: [worldId], references: [id])
  seasons Season[]

  @@index([worldId])
  @@map("competitions")
}

enum SeasonStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

model Season {
  id            String       @id @default(cuid())
  worldId       String
  competitionId String
  year          Int
  status        SeasonStatus @default(SCHEDULED)
  createdAt     DateTime     @default(now())

  world         World          @relation(fields: [worldId], references: [id])
  competition   Competition    @relation(fields: [competitionId], references: [id])
  fixtures      Fixture[]
  januaryEvents JanuaryEvent[]

  @@index([worldId])
  @@map("seasons")
}

enum FixtureStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  POSTPONED
}

model Fixture {
  id         String        @id @default(cuid())
  worldId    String
  seasonId   String
  matchday   Int
  homeClubId String
  awayClubId String
  status     FixtureStatus @default(SCHEDULED)
  matchId    String?       @unique

  world  World  @relation(fields: [worldId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])
  match  Match? @relation(fields: [matchId], references: [id])

  @@index([worldId, seasonId, matchday])
  @@map("fixtures")
}

/// Persists the (setup, seed, engineVersion) triple alongside the result — this is what makes matches reproducible and auditable.
model Match {
  id             String   @id @default(cuid())
  worldId        String
  /// MatchSetup snapshot from @futbol/domain.
  setup          Json
  seed           String
  engineVersion  String
  homeScore      Int
  awayScore      Int
  homeXg         Float
  awayXg         Float
  homePossession Float
  awayPossession Float
  createdAt      DateTime @default(now())

  world       World             @relation(fields: [worldId], references: [id])
  fixture     Fixture?
  events      MatchEvent[]
  playerStats PlayerMatchStat[]

  @@index([worldId])
  @@map("matches")
}

model MatchEvent {
  id      String @id @default(cuid())
  matchId String
  seq     Int
  minute  Int
  type    String
  /// The rest of the MatchEvent discriminated-union member, from @futbol/domain.
  payload Json

  match Match @relation(fields: [matchId], references: [id])

  @@index([matchId, seq])
  @@map("match_events")
}

model PlayerMatchStat {
  id              String @id @default(cuid())
  matchId         String
  playerId        String
  rating          Float
  goals           Int
  assists         Int
  shots           Int
  passesCompleted Int
  tackles         Int
  minutesPlayed   Int

  match Match @relation(fields: [matchId], references: [id])

  @@index([matchId])
  @@index([playerId])
  @@map("player_match_stats")
}

enum KnockoutRound {
  QF
  SF
  FINAL
}

/// A two-legged knockout tie (single match for FINAL, stored as firstLeg with secondLeg left null).
/// Fixture/Match don't otherwise capture "these two fixtures are one aggregate tie" — this is the
/// join. homeClubId/awayClubId are the nominal seeding order; homeClubId hosts the decisive leg 2.
model KnockoutTie {
  id                 String        @id @default(cuid())
  worldId            String
  competitionId      String
  round              KnockoutRound
  homeClubId         String
  awayClubId         String
  firstLegFixtureId  String?       @unique
  secondLegFixtureId String?       @unique
  winnerClubId       String?
  wentToPenalties    Boolean       @default(false)

  world World @relation(fields: [worldId], references: [id])

  @@index([worldId, competitionId])
  @@map("knockout_ties")
}

// ---- Phase 2+ models: schema-complete now, filled in as their phase lands ----

model Contract {
  id        String   @id @default(cuid())
  worldId   String
  clubId    String
  playerId  String
  wage      Int
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  club   WorldClub   @relation(fields: [clubId], references: [id])
  player WorldPlayer @relation(fields: [playerId], references: [id])

  @@index([worldId])
  @@map("contracts")
}

model Staff {
  id      String @id @default(cuid())
  worldId String
  clubId  String
  name    String
  role    String // "manager" | "assistant" | "scout" | "physio" | ...

  club WorldClub @relation(fields: [clubId], references: [id])

  @@index([worldId])
  @@map("staff")
}

model YouthPlayer {
  id         String   @id @default(cuid())
  worldId    String
  clubId     String
  name       String
  age        Int
  positions  String[]
  attributes Json
  potential  Int

  club WorldClub @relation(fields: [clubId], references: [id])

  @@index([worldId])
  @@map("youth_players")
}

model Finance {
  id         String   @id @default(cuid())
  worldId    String
  clubId     String
  balance    BigInt
  recordedAt DateTime @default(now())

  club WorldClub @relation(fields: [clubId], references: [id])

  @@index([worldId])
  @@map("finances")
}

enum TransferType {
  PERMANENT
  LOAN
  SWAP
}

enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

model Transfer {
  id         String         @id @default(cuid())
  worldId    String
  fromClubId String
  toClubId   String
  playerId   String
  feeCents   BigInt
  type       TransferType
  status     TransferStatus @default(PENDING)
  createdAt  DateTime       @default(now())

  world World @relation(fields: [worldId], references: [id])

  @@index([worldId])
  @@map("transfers")
}

enum JanuaryEventType {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

/// One resolved January Transfer Window gamble for a club within a domestic season — the
/// OUT/IN swap plus enough context to render Phase-4's narrative later. Kept separate from
/// Transfer (which models a single player moving between two WorldClubs) since a January
/// event is an atomic OUT+IN pair sourced from the ref catalog, not a world-to-world move,
/// and needs event-type + delta fields Transfer has no room for. @@unique on [seasonId, clubId]
/// is also the idempotency guard against double-resolving the same club's window.
model JanuaryEvent {
  id            String           @id @default(cuid())
  worldId       String
  seasonId      String
  clubId        String
  eventType     JanuaryEventType
  outPlayerId   String
  outPlayerName String
  outOverall    Int
  inPlayerId    String
  inPlayerName  String
  inOverall     Int
  delta         Int
  transferId    String?
  createdAt     DateTime         @default(now())

  world  World  @relation(fields: [worldId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([seasonId, clubId])
  @@index([worldId])
  @@map("january_events")
}

model Award {
  id       String @id @default(cuid())
  worldId  String
  seasonId String
  name     String
  winnerId String // clubId or playerId depending on award type

  // Lets finalize-run persistence use createMany + skipDuplicates to stay idempotent across
  // repeat calls (e.g. a user revisiting the stats hub) instead of accumulating duplicate rows.
  @@unique([worldId, seasonId, name])
  @@index([worldId])
  @@map("awards")
}

model WorldRecord {
  id       String @id @default(cuid())
  worldId  String
  name     String
  holderId String
  value    Float

  @@unique([worldId, name])
  @@index([worldId])
  @@map("records")
}

model Achievement {
  id         String   @id @default(cuid())
  worldId    String
  userId     String
  key        String
  unlockedAt DateTime @default(now())

  @@unique([worldId, userId, key])
  @@index([worldId])
  @@map("achievements")
}

/// One row per finished, submitted run (Phase 6). `worldId` is unique — resubmitting the same
/// world (e.g. re-visiting the stats hub, or a re-simulated season) upserts in place rather than
/// piling up duplicate rows for one save. `difficulty`/`ratingsMode` are self-reported Setup/Draft
/// config the backend never otherwise persists (DraftContext-only today); `formation`/`clubName`/
/// `won`/`drawn`/`lost`/`goalDiff`/`points`/`squadOverall` are all re-derived server-side from the
/// world's own standings/lineup at submit time, not trusted from the client, so the RESULT a viewer
/// sees is always what our own simulation actually produced. `verified` is always true in this
/// codebase — there is no client-side simulation path, so every run's matches were produced by the
/// sim-worker (see CLAUDE.md's "Simulation engine contract"); the column exists for schema parity
/// with 38-0's anti-tamper badge and to leave room for a future unverified submission path.
model LeaderboardEntry {
  id           String   @id @default(cuid())
  worldId      String   @unique
  userId       String
  handle       String
  /// "solo" (the default fantasy-XI mode) or "one-club" (Phase 7 — a squad drawn entirely from one
  /// real club's history). Derived server-side from World.settings.oneClubClubId at submission
  /// time, never trusted from the client — see leaderboard.service.ts's submitRun.
  mode         String   @default("solo")
  difficulty   String
  ratingsMode  String
  formation    String
  squadOverall Int
  clubName     String
  leagueName   String?
  /// The RefClub this run's squad was locked to, set only for mode="one-club" — a stronger,
  /// join-friendly identity than clubName (a fantasy XI's free-text name could coincidentally
  /// collide with a real club's name). Scopes the per-club leaderboard and the club-record-breaker/
  /// club-worst-ever trophy comparisons in leaderboard.service.ts.
  refClubId    String?
  won          Int
  drawn        Int
  lost         Int
  goalDiff     Int
  points       Int
  verified     Boolean  @default(true)
  reportCount  Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([mode, points])
  @@index([mode, refClubId, points])
  @@map("leaderboard_entries")
}

/// Phase 9a — async multiplayer Leagues: the creator locks shared draft/season rules once (era,
/// real league(s), difficulty, and either a fixed formation or per-member freedom — see 38-0's "same
/// rules for everyone" framing), generates an invite code, and everyone who joins independently
/// drafts + simulates their own solo World/Season under those rules. This is deliberately NOT one
/// shared World with N WorldClubs (that's the older, removed pass-and-play Head-to-Head model) — see
/// the plan doc's Phase 9 notes on why N-independent-seasons-ranked-by-points is simpler and matches
/// 38-0's own model. `creatorId` is a plain unlinked userId, same convention as `LeaderboardEntry.
/// userId`/`Achievement.userId` elsewhere in this schema (no enforced FK to User).
model MultiplayerLeague {
  id         String   @id @default(cuid())
  name       String
  creatorId  String
  inviteCode String   @unique
  /// { eraId, leagueIds: string[], difficulty, formationFreedom: boolean, formation?: Formation }
  /// — see leagues.schemas.ts's createLeagueSchema for the exact shape.
  rules      Json
  createdAt  DateTime @default(now())

  memberships   LeagueMembership[]
  liveDraftRoom LiveDraftRoom?

  @@map("multiplayer_leagues")
}

/// One user's spot in a MultiplayerLeague. `worldId` starts null (joined but hasn't drafted yet) and
/// is attached automatically the moment the member confirms their draft — WorldsService.createWorld
/// links it server-side when `World.settings.multiplayerLeagueId` is present, the same "derive from
/// World.settings, never trust the client" pattern `oneClubClubId` already established. Standings
/// are computed by joining these rows to `LeaderboardEntry` by `worldId` (LeaguesService.
/// getStandings) rather than duplicating season-result storage here.
model LeagueMembership {
  id       String   @id @default(cuid())
  leagueId String
  userId   String
  worldId  String?
  joinedAt DateTime @default(now())

  league MultiplayerLeague @relation(fields: [leagueId], references: [id])

  @@unique([leagueId, userId])
  @@map("league_memberships")
}

enum LiveDraftStatus {
  LOBBY
  IN_PROGRESS
  COMPLETED
}

/// Phase 9b — real-time turn-based Live Draft. Deliberately backed by a MultiplayerLeague (created
/// alongside the room, with `formationFreedom: false` — a fixed shared formation is what makes the
/// snake-order turn math well-defined for everyone) rather than a parallel rules/standings system —
/// this model's only job is orchestrating the synchronized picking phase itself. The moment picking
/// finishes, live-draft.gateway.ts submits each participant's picks through the exact same
/// DraftService.draftFantasy path a solo/async-league draft already uses, tagged with this league's
/// id, so simulation and standings are 100% reused Phase 9a infrastructure from that point on.
model LiveDraftRoom {
  id                String          @id @default(cuid())
  leagueId          String          @unique
  hostUserId        String
  inviteCode        String          @unique
  /// Seats fill in join order, 0-based; the host is always seat 0 (auto-joined at room creation).
  maxSeats          Int             @default(4)
  status            LiveDraftStatus @default(LOBBY)
  /// Global monotonic turn counter — whose turn it is is *derived* (live-draft.logic.ts's
  /// seatForPick), never stored redundantly, so there's only one source of truth to keep in sync.
  currentPickNumber Int             @default(0)
  /// Reset to now() at the start of every turn; the gateway's in-memory per-room timer compares
  /// against this (not a stored deadline) so a server restart just makes the current turn's timer
  /// start fresh rather than resuming a stale deadline.
  turnStartedAt     DateTime?
  createdAt         DateTime        @default(now())
  completedAt       DateTime?

  league       MultiplayerLeague      @relation(fields: [leagueId], references: [id])
  participants LiveDraftParticipant[]
  picks        LiveDraftPick[]

  @@map("live_draft_rooms")
}

model LiveDraftParticipant {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  /// Snapshotted at join time (not looked up live) so a display name change mid-draft doesn't
  /// retroactively relabel earlier picks in the room's shared log.
  displayName String
  seatIndex   Int
  /// Set once this participant's picks are successfully submitted via DraftService.draftFantasy at
  /// room completion — null until then, and stays null permanently if their squad couldn't fill the
  /// formation (see the gateway's per-participant error handling, not a whole-room failure).
  worldId     String?
  joinedAt    DateTime @default(now())

  room LiveDraftRoom @relation(fields: [roomId], references: [id])

  @@unique([roomId, userId])
  @@unique([roomId, seatIndex])
  @@map("live_draft_participants")
}

/// One drafted player. No slot/position column — unlike the old shared-World multiplayer model,
/// slot assignment isn't decided live during the turn; DraftService.draftFantasy's existing greedy
/// buildLineup does that at completion from the participant's full flat pick list, exactly like a
/// solo squad-first draft already does. `playerId` is denormalized from RefPlayerSeason purely so
/// `@@unique([roomId, playerId])` can enforce the shared-pool "nobody drafts the same real person
/// twice in this room" rule as a single DB constraint rather than an application-level scan.
model LiveDraftPick {
  id                String   @id @default(cuid())
  roomId            String
  participantId     String
  pickNumber        Int
  refPlayerSeasonId String
  playerId          String
  createdAt         DateTime @default(now())

  room LiveDraftRoom @relation(fields: [roomId], references: [id])

  @@unique([roomId, pickNumber])
  @@unique([roomId, playerId])
  @@map("live_draft_picks")
}

model ChatMessage {
  id        String   @id @default(cuid())
  worldId   String
  userId    String
  body      String
  createdAt DateTime @default(now())

  world World @relation(fields: [worldId], references: [id])

  @@index([worldId, createdAt])
  @@map("chat_messages")
}

/// Phase 8 — Daily Challenge: one deterministically-generated puzzle per calendar date (UTC),
/// lazily created on the first `/daily/today` request of the day and reused by every later request/
/// user for that same date (see daily.service.ts's getTodayChallenge) — "everyone sees the same
/// puzzle" falls out of `date` being unique and generation being a pure function of it, not of a
/// cron job. `anchorPlayerSeasonId` is pre-seeded into the user's squad, never drafted. `constraints`
/// is a `DailyConstraint[]` (see daily.logic.ts) stored as JSON since its shape varies by theme.
/// `poolStats` snapshots the generation-time pool sizes the completion-odds calculator needs
/// (apps/web/src/lib/dailyOdds.ts) so later reads don't have to re-scan the whole catalog.
model DailyChallenge {
  id                   String   @id @default(cuid())
  date                 DateTime @unique
  theme                String
  themeLabel           String
  anchorPlayerSeasonId String
  fixedFormation       String
  constraints          Json
  poolStats            Json
  refreshesAt          DateTime
  createdAt            DateTime @default(now())

  entries DailyChallengeEntry[]

  @@map("daily_challenges")
}

/// One row per user per challenge (best-attempt kept) — `attemptsUsed` enforces the 5-attempts/day
/// economy (daily.service.ts's submitAttempt rejects a 6th) and doubles as this challenge's entry in
/// the daily leaderboard, ranked by `score` desc. Distinct from `LeaderboardEntry`: a daily run has no
/// world/season behind it at all (no simulation), just a scored draft, so it doesn't fit that model's
/// won/drawn/lost/points shape.
model DailyChallengeEntry {
  id               String   @id @default(cuid())
  dailyChallengeId String
  userId           String
  handle           String
  squadOverall     Int
  score            Int
  maxScore         Int
  attemptsUsed     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dailyChallenge DailyChallenge @relation(fields: [dailyChallengeId], references: [id])

  @@unique([dailyChallengeId, userId])
  @@index([dailyChallengeId, score])
  @@map("daily_challenge_entries")
}
